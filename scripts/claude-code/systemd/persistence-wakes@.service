[Unit]
Description=Fire %i's Persistence wakes that no live Claude Code session took

[Service]
Type=oneshot
User=%i
# A login shell, so claude and the peer's PATH are found as in their own sessions.
# run-due starts each resume detached and exits; by default systemd then kills the whole cgroup, so every
# resumed run died at once and no wake ever carried on (found 2026-11-09 with Arden's /compact wake).
KillMode=process
ExecStart=/bin/bash -lc 'python3 "$HOME/.claude/persistence/hook.py" run-due'
