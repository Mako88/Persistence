[Unit]
Description=Check each night that %i's room bridge got every message

[Timer]
# 04:30 server time: after the 03:30 backup and the 04:00 security reboot, so the bridge is back up (its catch-up
# done) and `room say` can post. A run checks from where the last one stopped, so a missed night loses nothing.
OnCalendar=*-*-* 04:30:00
Persistent=true

[Install]
WantedBy=timers.target
